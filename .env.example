# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# None of these are NEXT_PUBLIC_*: they stay on the server and never reach the browser.

# Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Optional: override the analysis model (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Password for the site (HTTP Basic Auth, any username). Required in production.
APP_PASSWORD=
